#Unearthed Configs
#
["general settings"]
	enable_regolith_to_dirt_recipe = false

["generation settings"]
	enable_debug = false
	disable_all = false
	disable_cobble = false
	disable_dirt = false
	disable_ore = false

[compatibility]
	#Reserves a small amount of vanilla andesite when Create is installed.
	enable_create_andesite_reserve = true
